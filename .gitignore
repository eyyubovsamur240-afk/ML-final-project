# --- Data: never commit the raw archive or the extracted dataset ---
data/*
!data/README.md

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.venv/
venv/
env/

